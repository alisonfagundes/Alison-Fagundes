// Classe do componente
public class Motor {
    public void ligar() {
        System.out.println("Vroom! O motor foi ligado.");
    }
}

// Classe que USA a composição
public class Carro {
    String modelo;
    Motor motor = new Motor(); // Composição: o Carro TEM UM Motor dentro dele

    public void ligarCarro() {
        System.out.println("Ligando o " + modelo + "...");
        motor.ligar(); // Delegação: o carro pede para o motor ligar
    }
}
